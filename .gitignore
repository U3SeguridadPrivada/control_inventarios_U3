# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
build/
.next/
next-env.d.ts

# SQLite database (persists via Railway Volume)
db/*.db
db/*.db-shm
db/*.db-wal
db/*.db.backup*
db/backups/

# Exportaciones de Kapso e informes: llevan nombres y teléfonos de candidatos.
# Datos personales — nunca al repositorio.
db/recuperacion/

# Lotes de prospeccion DENUE: llevan telefonos y correos de establecimientos.
# El padron de ids (prospeccion/entregados.json) si se versiona: evita repetir lotes.
prospeccion/*.csv
prospeccion/*.xlsx

# Environment variables — NEVER commit these
.env
.env.local
.env.*.local
apps/api/.env
apps/web/.env

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local temporary build cache
.temp/

