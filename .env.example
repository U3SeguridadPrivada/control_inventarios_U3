JWT_SECRET=cambia-esto-por-una-cadena-aleatoria-de-minimo-32-caracteres

# Gemini API Key (Obtenida en Google AI Studio)
GEMINI_API_KEY=tu_api_key_de_gemini
# Modelo de Gemini para el bot de WhatsApp (opcional)
GEMINI_MODEL=gemini-2.0-flash

# Proveedor de WhatsApp: "wasender" (no oficial) o "meta" (oficial Cloud API)
WHATSAPP_PROVIDER=wasender

# Configuración de WASender
WASENDER_API_URL=https://www.wasenderapi.com/api/send-message
WASENDER_API_KEY=tu_api_key_de_wasender

# WhatsApp Cloud API oficial de Meta (usar cuando WHATSAPP_PROVIDER=meta)
META_PHONE_NUMBER_ID=id_del_numero_en_meta
META_ACCESS_TOKEN=token_permanente_de_meta
META_VERIFY_TOKEN=cadena_inventada_para_verificar_el_webhook
META_APP_SECRET=secreto_de_la_app_para_validar_firmas
# META_GRAPH_VERSION=v21.0

# Proveedor Kapso (usar cuando WHATSAPP_PROVIDER=kapso)
KAPSO_PHONE_NUMBER_ID=id_del_numero_en_kapso
KAPSO_API_KEY=tu_api_key_de_kapso
KAPSO_VERSION=v24.0

